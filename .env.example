# Copy this file to .env and fill in keys to enable real AI responses.
# If no key is set, Penny runs in MOCK mode (rule-based responses, no API calls).

# Preferred provider when a key is available: anthropic | openai | mock
PENNY_AI_PROVIDER=mock

# Anthropic (preferred real provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
